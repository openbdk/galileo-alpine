# builds/versions.env — pinned upstream versions and checksums for the
# Descartes (Debian, source) and Chomsky (Alpine, binary) build lines.
#
# Every archive fetched by builds/ is checked against a hash in this file.
# To bump a version: change the version, replace the hashes from the
# upstream SHA256SUMS / .sha256 files, and rerun `<build> verify`.
# Checked 2026-09-25.

# ─── Alpine (Chomsky) ────────────────────────────────────────────────
ALPINE_BRANCH="v3.24"

# ─── Debian (Descartes) ──────────────────────────────────────────────
DEBIAN_SUITES="bookworm trixie"

# ─── Bitcoin Core ────────────────────────────────────────────────────
# Source: https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/SHA256SUMS
# Alpine community ships its own musl build (30.2 on v3.24); Chomsky uses
# that by default and builds this pinned source only with --source.
BITCOIN_VERSION="31.1"
BITCOIN_SRC_SHA256="50411d5b43c7e4c90099394759eb6c2add6e7c2dbe728840893d638b6fc6afc9"
BITCOIN_BIN_SHA256_x86_64="b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e"
BITCOIN_BIN_SHA256_aarch64="dcf1873f2208ba4f962f3398d47e154c39c0084be8f4553e05c940d0ace3d004"

# ─── Foundry (forge, cast, anvil, chisel) ───────────────────────────
# Source: https://github.com/foundry-rs/foundry/releases/tag/${FOUNDRY_VERSION}
# foundryup installs glibc binaries; on Alpine (musl) use the *_alpine_*
# archives, which is what Chomsky does.
FOUNDRY_VERSION="v1.8.3"
FOUNDRY_SHA256_alpine_amd64="72a0e8ce069c50655a7d7d939089a42e242debfb902339b26561dd3e8757d6c0"
FOUNDRY_SHA256_alpine_arm64="e48bf466874a9684a4f75ce6b6eb8e068083b7138aec597c7f5b6810ed462010"
FOUNDRY_SHA256_linux_amd64="7ca48e6ca3cac1bce1403ca67e5bc1dc3bc1fd818199c9957c7165079c228568"
FOUNDRY_SHA256_linux_arm64="93fc23be26c8a902ca58fe54aa6ca28c880b58af95d052674933161df7928e6d"

# ─── RAM builds (bankon.heads / bankon.tails) ───────────────────────
# heads: Devuan (sysvinit), bootstrapped with debootstrap's generic Devuan
# script (ceres) and Devuan's archive keyring, itself pinned by sha256 as
# listed in excalibur's signed Packages index.
DEVUAN_SUITE="excalibur"                       # Devuan 6.0 stable
DEVUAN_MIRROR="http://deb.devuan.org/merged"
DEVUAN_KEYRING_URL="https://pkgmaster.devuan.org/merged/pool/DEVUAN/main/d/devuan-keyring/devuan-keyring_2025.08.09_all.deb"
DEVUAN_KEYRING_SHA256="1d87328cb485c96ee5c9eca06bba05159183099a4c6df6121052fc1047cf594f"
# tails: Debian (systemd)
TAILS_SUITE="trixie"
DEBIAN_MIRROR="http://deb.debian.org/debian"
