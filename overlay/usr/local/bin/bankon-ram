#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════
#  bankon-ram — RAM toolkit for bankon.heads and bankon.tails
# ══════════════════════════════════════════════════════════════════════
#
#  The system runs from RAM: the whole root is one compressed squashfs
#  copied into memory at boot (live-boot `toram`, as dyne:bolic loads its
#  image into RAM), so the boot medium can be pulled once booted. This
#  tool measures and tunes that, and wipes what must not survive.
#
#  Built on GNU tools first (coreutils dd/sha256sum/shred/timeout, procps,
#  util-linux zramctl/blkdiscard), net-tools and iproute2; stress-ng,
#  sysbench, openssl, ethtool, mtr, secure-delete are used when present.
#
#  Usage:
#    bankon-ram status                       RAM, toram, zram, tmpfs, top RSS
#    bankon-ram zram [PERCENT] [ALGO]        compressed swap in RAM (default 50 zstd)
#    bankon-ram tune                         sysctl for a RAM-only system
#    bankon-ram compress-test [PATH] [MiB]   compressor ratio + speed on a sample
#    bankon-ram squashfs-test [PATH]         mksquashfs size/time per compressor
#    bankon-ram bench [SECONDS]              CPU + memory throughput
#    bankon-ram net                          local network diagnostics (no probes)
#    bankon-ram net-probe HOST               ping/traceroute/mtr to HOST (sends traffic)
#    bankon-ram shred PATH...                overwrite then delete files (GNU shred)
#    bankon-ram wipe-ram                     shred RAM vault, reset zram, drop caches, sdmem
#    bankon-ram wipe-device /dev/X           erase a whole device (asks to confirm)
#    bankon-ram report                       status + bench + compress-test to a RAM file
# ══════════════════════════════════════════════════════════════════════

set -uo pipefail

readonly RAM_VAULT="${BANKON_RAM_VAULT:-/run/bankon-vault}"
readonly REPORT_DIR="/run/bankon-ram"

B=$'\033[1m' C=$'\033[0;36m' Y=$'\033[1;33m' R=$'\033[0;31m' G=$'\033[0;32m' N=$'\033[0m'
[[ -t 1 ]] || { B= C= Y= R= G= N=; }
hdr()  { printf '\n%s── %s ──%s\n' "${B}${C}" "$*" "${N}"; }
kv()   { printf '  %-22s %s\n' "$1" "$2"; }
warn() { printf '%s[warn]%s %s\n' "${Y}" "${N}" "$*" >&2; }
die()  { printf '%s[fail]%s %s\n' "${R}" "${N}" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
root() { [[ $EUID -eq 0 ]] || die "$1 needs root"; }
# is a process with this exact name running? (pgrep if present, else /proc)
running() {
    if have pgrep; then pgrep -x "$1" >/dev/null; return; fi
    grep -qx "$1" /proc/[0-9]*/comm 2>/dev/null
}

# elapsed seconds of a command, output discarded. /proc/uptime (10 ms)
# works under GNU and busybox alike; busybox date has no %N.
now() { awk '{ print $1 }' /proc/uptime; }
timed() {
    local t0 t1
    t0=$(now)
    "$@" >/dev/null 2>&1 || return 1
    t1=$(now)
    awk -v a="$t0" -v b="$t1" 'BEGIN { d = b - a; if (d <= 0) d = 0.01; printf "%.2f", d }'
}
mibps() { awk -v m="$1" -v s="$2" 'BEGIN { if (s > 0) printf "%.1f", m / s; else print "-" }'; }

# ── status ───────────────────────────────────────────────────────────
cmd_status() {
    hdr "memory"
    awk '/^(MemTotal|MemAvailable|Cached|Shmem|SwapTotal|SwapFree):/ { printf "  %-22s %8.0f MiB\n", $1, $2/1024 }' /proc/meminfo

    hdr "running from RAM"
    if grep -qw toram /proc/cmdline; then
        kv "toram" "yes (boot medium can be removed)"
    elif [[ -f /etc/alpine-release ]] && awk '$2 == "/" && $3 == "tmpfs" { f = 1 } END { exit !f }' /proc/mounts; then
        kv "diskless" "yes — Alpine root on tmpfs (nothing kept unless lbu commit)"
        have lbu && kv "lbu media" "$(. /etc/lbu/lbu.conf 2>/dev/null; echo "${LBU_MEDIA:-none}")"
    else
        kv "toram" "no — root is read from the boot medium"
    fi
    grep -qw init_on_free=1 /proc/cmdline && kv "init_on_free" "on (freed pages are zeroed)" || kv "init_on_free" "off"
    local sq
    for sq in /run/live/medium/live/filesystem.squashfs /run/live/rootfs/filesystem.squashfs; do
        [[ -f "$sq" ]] && kv "squashfs" "$(du -h "$sq" | cut -f1) $sq"
    done

    hdr "zram / swap"
    if have zramctl && [[ -n "$(zramctl --noheadings 2>/dev/null)" ]]; then
        zramctl --output NAME,ALGORITHM,DISKSIZE,DATA,COMPR,TOTAL,MOUNTPOINT 2>/dev/null | sed 's/^/  /'
    else
        kv "zram" "none (bankon-ram zram)"
    fi
    [[ -s /proc/swaps ]] && sed 's/^/  /' /proc/swaps

    hdr "tmpfs"
    df -h -t tmpfs 2>/dev/null | sed 's/^/  /'

    hdr "largest processes (RSS)"
    # /proc/*/status works with busybox as well as procps
    awk '/^Name:/ { n = $2 } /^VmRSS:/ { printf "%d %s\n", $2, n }' /proc/[0-9]*/status 2>/dev/null \
        | sort -rn | head -8 | awk '{ printf "  %8.1f MiB  %s\n", $1/1024, $2 }'
}

# ── zram + tune ──────────────────────────────────────────────────────
cmd_zram() {
    root zram
    local pct="${1:-50}" algo="${2:-zstd}" total size dev
    have zramctl || die "zramctl (util-linux) not found"
    modprobe zram 2>/dev/null || true
    [[ -e /sys/class/zram-control ]] || die "kernel has no zram"
    if [[ -r /sys/block/zram0/comp_algorithm ]] && ! grep -qw "$algo" /sys/block/zram0/comp_algorithm; then
        warn "$algo not offered by this kernel ($(cat /sys/block/zram0/comp_algorithm)); using lz4"
        algo=lz4
    fi
    total=$(awk '/MemTotal/ { print $2 }' /proc/meminfo)
    size=$(( total * pct / 100 ))K
    dev=$(zramctl --find --size "$size" --algorithm "$algo") || die "zramctl failed"
    mkswap -q "$dev" && swapon -p 100 "$dev" || die "swapon $dev failed"
    kv "zram swap" "$dev  $size  $algo  priority 100"
}

cmd_tune() {
    root tune
    # zram is the only swap: favour it over dropping page cache, and read
    # one page at a time (no readahead benefit on RAM-backed swap).
    sysctl -q -w vm.swappiness=100 vm.page-cluster=0 vm.vfs_cache_pressure=50 \
        kernel.kptr_restrict=2 kernel.dmesg_restrict=1 || warn "some sysctls refused"
    kv "vm.swappiness" "$(sysctl -n vm.swappiness)"
    kv "vm.page-cluster" "$(sysctl -n vm.page-cluster)"
    kv "vm.vfs_cache_pressure" "$(sysctl -n vm.vfs_cache_pressure)"
}

# ── compression testing ──────────────────────────────────────────────
# sample: first MIB of a tar of PATH, written to RAM (tmpfs) so disk speed
# does not enter the measurement.
make_sample() {
    local path="$1" mib="$2" out="$3"
    local gnu=()
    tar --version 2>/dev/null | grep -q GNU && gnu=(--ignore-failed-read)   # busybox tar lacks it
    tar -cf - "${gnu[@]}" -C / "${path#/}" 2>/dev/null | head -c $(( mib * 1048576 )) > "$out"
    [[ -s "$out" ]] || die "could not sample $path"
}

cmd_compress_test() {
    local path="${1:-/usr}" mib="${2:-64}" work sample bytes insize
    work=$(mktemp -d /dev/shm/bankon-ct.XXXXXX 2>/dev/null || mktemp -d)
    trap 'rm -rf "$work"' RETURN
    sample="$work/sample.tar"
    make_sample "$path" "$mib" "$sample"
    bytes=$(stat -c %s "$sample"); insize=$(awk -v b="$bytes" 'BEGIN { printf "%.1f", b/1048576 }')
    hdr "compress-test: ${insize} MiB of $path (in RAM)"
    printf '  %-10s %8s %8s %12s %12s\n' codec ratio "MiB" "comp MiB/s" "decomp MiB/s"
    local spec name cmd dcmd tc td out osz
    for spec in "gzip:gzip -6 -c:gzip -dc" "bzip2:bzip2 -9 -c:bzip2 -dc" "xz:xz -6 -T1 -c:xz -dc" \
                "zstd-3:zstd -3 -q -c:zstd -dqc" "zstd-19:zstd -19 -q -c:zstd -dqc" \
                "lz4:lz4 -q -c:lz4 -dqc" "lzop:lzop -c:lzop -dc"; do
        IFS=: read -r name cmd dcmd <<<"$spec"
        have "${cmd%% *}" || { printf '  %-10s %s\n' "$name" "(not installed)"; continue; }
        out="$work/out"
        tc=$(timed sh -c "$cmd < '$sample' > '$out'") || { printf '  %-10s failed\n' "$name"; continue; }
        osz=$(stat -c %s "$out")
        td=$(timed sh -c "$dcmd < '$out' > /dev/null") || td=0
        printf '  %-10s %8s %8.1f %12s %12s\n' "$name" \
            "$(awk -v a="$bytes" -v b="$osz" 'BEGIN { printf "%.2f", a/b }')" \
            "$(awk -v b="$osz" 'BEGIN { print b/1048576 }')" "$(mibps "$insize" "$tc")" "$(mibps "$insize" "$td")"
        rm -f "$out"
    done
    echo "  ratio = input/output; for a toram image, output size is RAM spent, decomp speed is boot time"
}

cmd_squashfs_test() {
    local path="${1:-/usr}" work c t sz
    have mksquashfs || die "mksquashfs (squashfs-tools) not found"
    work=$(mktemp -d /dev/shm/bankon-sq.XXXXXX 2>/dev/null || mktemp -d)
    trap 'rm -rf "$work"' RETURN
    hdr "squashfs-test: $path ($(du -sh "$path" 2>/dev/null | cut -f1) on disk)"
    printf '  %-6s %10s %10s\n' comp size seconds
    for c in gzip lzo lz4 xz zstd; do
        t=$(timed mksquashfs "$path" "$work/t.sqfs" -comp "$c" -noappend -no-progress -processors 2 -mem 256M) \
            || { printf '  %-6s %s\n' "$c" "(unsupported)"; continue; }
        sz=$(du -h "$work/t.sqfs" | cut -f1)
        printf '  %-6s %10s %10s\n' "$c" "$sz" "$t"
        rm -f "$work/t.sqfs"
    done
}

# ── CPU / memory benchmark ───────────────────────────────────────────
cmd_bench() {
    local secs="${1:-5}" n mib t par
    n=$(nproc)
    hdr "cpu"
    kv "model" "$(awk -F': ' '/model name|^Model/ { print $2; exit }' /proc/cpuinfo)"
    kv "threads" "$n"
    [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]] && \
        kv "governor" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"

    hdr "GNU coreutils (sha256sum over RAM)"
    mib=512
    t=$(timed sh -c "head -c $((mib * 1048576)) /dev/zero | sha256sum")
    kv "sha256, 1 thread" "$(mibps "$mib" "$t") MiB/s"
    par=$(timed sh -c "for i in \$(seq $n); do head -c $((mib * 1048576)) /dev/zero | sha256sum & done; wait")
    kv "sha256, $n threads" "$(mibps $((mib * n)) "$par") MiB/s total"
    t=$(timed dd if=/dev/zero of=/dev/null bs=1M count=4096)
    kv "memory copy (dd)" "$(mibps 4096 "$t") MiB/s"

    if have openssl; then
        hdr "openssl speed (${secs}s each)"
        { openssl speed -seconds "$secs" sha256 2>/dev/null
          openssl speed -seconds "$secs" -evp aes-256-gcm 2>/dev/null; } \
            | awk 'tolower($1) ~ /^(sha256|aes-256-gcm)$/' | sed 's/^/  /'
    fi
    if have stress-ng; then
        hdr "stress-ng cpu (${secs}s, $n workers)"
        stress-ng --cpu "$n" --cpu-method all --metrics-brief -t "${secs}s" 2>&1 | awk '/cpu /' | sed 's/^/  /'
    fi
    if have sysbench; then
        hdr "sysbench cpu (${secs}s, $n threads)"
        sysbench cpu --threads="$n" --time="$secs" run 2>/dev/null | awk '/events per second/' | sed 's/^/  /'
    fi
}

# ── network ──────────────────────────────────────────────────────────
cmd_net() {
    hdr "interfaces"
    if have ip; then ip -br link; ip -br addr; fi | sed 's/^/  /'
    have ifconfig && { echo "  (net-tools)"; ifconfig -a 2>/dev/null | awk '/^[a-z]/ || /inet|ether/' | sed 's/^/    /'; }
    hdr "routes"
    have ip && ip route | sed 's/^/  /'
    have route && route -n 2>/dev/null | sed 's/^/  /'
    hdr "neighbours"
    have ip && ip neigh | sed 's/^/  /'
    have arp && arp -n 2>/dev/null | sed 's/^/  /'
    hdr "listening sockets"
    if have ss; then ss -tulpn 2>/dev/null; elif have netstat; then netstat -tulpn 2>/dev/null; fi | sed 's/^/  /'
    hdr "dns"
    grep -E '^(nameserver|search)' /etc/resolv.conf 2>/dev/null | sed 's/^/  /'
    hdr "tor"
    if running tor; then kv "tor" "running"; else kv "tor" "not running"; fi
    if have ss && ss -ltn 2>/dev/null | grep -q ':9050 '; then kv "socks" "127.0.0.1:9050"; fi
    if have ethtool; then
        local i
        for i in $(ls /sys/class/net | grep -v '^lo$'); do
            ethtool "$i" 2>/dev/null | awk -v i="$i" '/Speed|Duplex|Link detected/ { printf "  %-8s %s\n", i, $0 }'
        done
    fi
    net_tails_checks
    echo "  (local only — nothing was sent off the machine; use net-probe HOST to test reachability)"
}

# The checks Tails puts in front of its user before trusting the network:
# is the hardware address spoofed, is everything forced through Tor, has Tor
# finished bootstrapping, is the clock sane (Tor refuses a skewed clock), and
# where does DNS go. All read locally; nothing is sent off the machine.
tor_control() {
    # GETINFO over the control port with cookie auth, using bash /dev/tcp + od.
    local cookie="" f q="$1"
    for f in /run/tor/control.authcookie /var/run/tor/control.authcookie /var/lib/tor/control_auth_cookie; do
        [[ -r "$f" ]] && { cookie=$(od -An -tx1 -v "$f" | tr -d ' \n'); break; }
    done
    { exec 3<>/dev/tcp/127.0.0.1/9051; } 2>/dev/null || return 1
    printf 'AUTHENTICATE %s\r\nGETINFO %s\r\nQUIT\r\n' "$cookie" "$q" >&3
    timeout 3 cat <&3 | tr -d '\r' | sed -n "s/^250[- ]$q=//p"
    exec 3<&- 3>&-
}

net_tails_checks() {
    hdr "tails checks"
    local i perm cur
    for i in $(ls /sys/class/net | grep -v '^lo$'); do
        cur=$(cat /sys/class/net/"$i"/address 2>/dev/null)
        perm=$(have ethtool && ethtool -P "$i" 2>/dev/null | awk '{ print $NF }')
        [[ "$perm" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || perm=""
        if [[ -z "$perm" || "$perm" == "00:00:00:00:00:00" ]]; then
            kv "mac $i" "$cur (permanent address unknown)"
        elif [[ "$perm" == "$cur" ]]; then
            kv "mac $i" "$cur — NOT spoofed (macchanger -r $i)"
        else
            kv "mac $i" "$cur — spoofed (hardware $perm)"
        fi
    done

    if have nft && nft list ruleset >/dev/null 2>&1; then
        if nft list chain inet bankon output 2>/dev/null | grep -q 'policy drop'; then
            kv "firewall" "Tor-only (inet bankon output: policy drop, tor + loopback allowed)"
        else
            kv "firewall" "no Tor-only output policy — traffic can leave outside Tor"
        fi
    elif have iptables; then
        iptables -S OUTPUT 2>/dev/null | grep -q -- '-P OUTPUT DROP' \
            && kv "firewall" "iptables OUTPUT policy DROP" || kv "firewall" "iptables OUTPUT accepts by default"
    else
        kv "firewall" "none found"
    fi

    local boot
    if boot=$(tor_control status/bootstrap-phase) && [[ -n "$boot" ]]; then
        kv "tor bootstrap" "$(sed -E 's/.*PROGRESS=([0-9]+).*SUMMARY="([^"]*)".*/\1% \2/' <<<"$boot")"
    elif running tor; then
        kv "tor bootstrap" "tor running; control port 9051 not readable"
    else
        kv "tor bootstrap" "tor not running"
    fi

    kv "clock (UTC)" "$(date -u '+%Y-%m-%d %H:%M:%S')"
    if have timedatectl; then
        kv "clock sync" "$(timedatectl show -p NTPSynchronized --value 2>/dev/null | sed 's/yes/synchronized/;s/no/not synchronized — Tor fails on a skewed clock/')"
    fi
    local ns; ns=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)
    case "$ns" in
        127.*|::1) kv "dns" "$ns (local — Tor DNSPort or stub)" ;;
        "") kv "dns" "no nameserver" ;;
        *) kv "dns" "$ns — resolves outside Tor" ;;
    esac
}

cmd_net_probe() {
    local host="${1:?usage: bankon-ram net-probe HOST}"
    warn "sending traffic to $host — on bankon.tails this leaves outside Tor unless torsocks is used"
    hdr "ping $host"; ping -c 4 -W 2 "$host" 2>&1 | tail -3 | sed 's/^/  /'
    if have mtr; then hdr "mtr $host"; mtr -r -c 5 "$host" 2>&1 | sed 's/^/  /'
    elif have traceroute; then hdr "traceroute $host"; traceroute -w 2 "$host" 2>&1 | sed 's/^/  /'; fi
}

# ── wiping ───────────────────────────────────────────────────────────
# GNU shred overwrites in place. That works on tmpfs (RAM) and plain
# magnetic disks. On flash (USB, SSD) wear-levelling moves blocks, and on
# journaling / copy-on-write filesystems old copies survive: there, only
# encryption (Tomb) with the key destroyed, or erasing the whole device,
# is reliable. The command says which case it is in.
fs_note() {
    local fs; fs=$(stat -f -c %T "$1" 2>/dev/null)
    case "$fs" in
        tmpfs|ramfs) echo "ram" ;;
        ext2/ext3|msdos|vfat) echo "inplace" ;;
        *) echo "$fs" ;;
    esac
}

cmd_shred() {
    [[ $# -gt 0 ]] || die "usage: bankon-ram shred PATH..."
    local p kind
    for p in "$@"; do
        [[ -e "$p" ]] || { warn "$p: not found"; continue; }
        kind=$(fs_note "$p")
        case "$kind" in
            ram|inplace) ;;
            *) warn "$p is on $kind — copies may survive shred there (journal/flash); prefer Tomb + key destruction" ;;
        esac
        if [[ -d "$p" ]]; then
            find "$p" -xdev -type f -print0 | xargs -0 -r shred -f -z -u -n 3
            find "$p" -xdev -mindepth 1 -depth -type d -empty -delete
            # a mount point (the RAM vault) is emptied, not removed
            mountpoint -q "$p" 2>/dev/null || rmdir "$p" 2>/dev/null || true
        else
            shred -f -z -u -n 3 "$p"
        fi
        kv "shredded" "$p ($kind)"
    done
}

cmd_wipe_ram() {
    root wipe-ram
    if [[ -d "$RAM_VAULT" ]]; then
        cmd_shred "$RAM_VAULT"
        mountpoint -q "$RAM_VAULT" && umount "$RAM_VAULT"
    fi
    local d
    for d in $(awk '/zram/ { print $1 }' /proc/swaps); do swapoff "$d" && zramctl --reset "$d"; done
    sync; echo 3 > /proc/sys/vm/drop_caches
    if have sdmem; then
        kv "sdmem" "overwriting free RAM (secure-delete, one pass)"
        sdmem -ll -f
    fi
    grep -qw init_on_free=1 /proc/cmdline && kv "init_on_free" "kernel zeroes pages as they are freed"
    kv "wipe-ram" "done"
}

cmd_wipe_device() {
    root wipe-device
    local dev="${1:?usage: bankon-ram wipe-device /dev/X}" answer
    [[ -b "$dev" ]] || die "$dev is not a block device"
    grep -q "^$dev" /proc/mounts && die "$dev (or a partition) is mounted"
    lsblk -o NAME,SIZE,MODEL,TRAN,ROTA "$dev" | sed 's/^/  /'
    read -r -p "Type the device path again to destroy everything on it: " answer
    [[ "$answer" == "$dev" ]] || die "not confirmed"
    if have blkdiscard && blkdiscard --secure "$dev" 2>/dev/null; then
        kv "blkdiscard" "secure discard done"
    elif [[ "$(cat /sys/block/"$(basename "$dev")"/queue/rotational 2>/dev/null)" == 0 ]] && have blkdiscard && blkdiscard -f "$dev" 2>/dev/null; then
        kv "blkdiscard" "discard done (not a secure erase); overwriting once as well"
        shred -f -z -n 0 -v "$dev"
    else
        shred -f -z -n 1 -v "$dev"
    fi
}

# ── report ───────────────────────────────────────────────────────────
cmd_report() {
    mkdir -p "$REPORT_DIR"; chmod 700 "$REPORT_DIR" 2>/dev/null || true
    local f="$REPORT_DIR/report-$(date +%Y%m%dT%H%M%S).txt"
    { echo "bankon-ram report $(date -Iseconds) $(uname -srm)"; cmd_status; cmd_bench 3; cmd_compress_test /usr 32; cmd_net; } > "$f" 2>&1
    echo "$f"
}

usage() { sed -n '18,31p' "$0" | sed 's/^#  \{0,1\}//'; }

cmd="${1:-status}"; shift || true
case "$cmd" in
    status)        cmd_status ;;
    zram)          cmd_zram "$@" ;;
    tune)          cmd_tune ;;
    compress-test) cmd_compress_test "$@" ;;
    squashfs-test) cmd_squashfs_test "$@" ;;
    bench)         cmd_bench "$@" ;;
    net)           cmd_net ;;
    net-probe)     cmd_net_probe "$@" ;;
    shred)         cmd_shred "$@" ;;
    wipe-ram)      cmd_wipe_ram ;;
    wipe-device)   cmd_wipe_device "$@" ;;
    report)        cmd_report ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
esac
